# 智能知识库平台本地开发/联调环境变量模板
# 复制为 deploy/env/.env 后填写；真实 .env 永远不要提交。

# 必填：PostgreSQL 密码与 JWT 签名密钥。数据库密码需使用 URL-safe 字符，
# 因为 Compose 会把它嵌入 DATABASE_URL；不要使用 @、:、/、?、#、[、]。
POSTGRES_PASSWORD=change-me-to-a-secure-password
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# 生产必填：分别生成稳定 Fernet 密钥和独立下载签名密钥；不要与 SECRET_KEY 复用。
# MODEL_KEY_FERNET_KEY=<YOUR_FERNET_KEY>
# EXPORT_DOWNLOAD_SIGNING_KEY=<YOUR_EXPORT_SIGNING_KEY>

# 演示数据默认关闭；仅在隔离演示环境显式开启。
# 生产环境必须保持 false。
APP_ENVIRONMENT=development
AUTO_SEED_DEMO_DATA=false
# 仅当 AUTO_SEED_DEMO_DATA=true 时必填，至少 12 位；不要提交真实值。
# DEMO_SEED_PASSWORD=<YOUR_DEMO_SEED_PASSWORD>
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false

# 可选：固定本地发布/回滚镜像标签；源码构建默认使用 local。
APP_IMAGE_TAG=local

# RAG 问答（OpenAI 兼容）。API Key 只写入本地 .env。
# DeepSeek 示例：DEEPSEEK_BASE_URL=https://api.deepseek.com DEEPSEEK_CHAT_MODEL=deepseek-chat
# MiniMax 示例：DEEPSEEK_BASE_URL=https://api.minimax.io/v1 DEEPSEEK_CHAT_MODEL=MiniMax-M3
# DEEPSEEK_API_KEY=<YOUR_CHAT_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# DashScope Embedding。API Key 只写入本地 .env。
# text-embedding-v2 固定 1536 维；v3/v4 可配 1024（需与库表 vector 维一致）。
# DASHSCOPE_API_KEY=<YOUR_DASHSCOPE_API_KEY>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v2
QWEN_EMBEDDING_DIMENSIONS=1536

# DashScope 纯文本 Rerank，与 Embedding 复用 DASHSCOPE_API_KEY。
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
QWEN_RERANK_MODEL=qwen3-rerank

# RAG 问答缓存（Redis）：相同作用域内先精确命中，再对高相似且意图兼容的问题复用
# RAG_ANSWER_CACHE_ENABLED=true
# RAG_ANSWER_CACHE_TTL_SECONDS=604800
# RAG_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.92
# RAG_ANSWER_CACHE_CANDIDATE_LIMIT=50

# 查询预处理：同一次聊天模型调用完成语义守卫和检索改写，结果在 Redis 中短期复用。
RAG_QUERY_REWRITE_ENABLED=true
# 可留空，留空时优先复用用户在页面所选聊天模型，再回退环境默认模型。
# RAG_QUERY_REWRITE_MODEL_ID=
RAG_QUERY_REWRITE_MAX_VARIANTS=3
RAG_QUERY_PREPROCESS_CACHE_TTL_SECONDS=900
RAG_SEMANTIC_GUARD_ENABLED=true
# RAG_SEMANTIC_GUARD_MODEL_ID=
RAG_SEMANTIC_GUARD_TIMEOUT_SECONDS=8
# 模型故障默认放行并由检索接口继续处理，避免合法敏感词语境被关键词误伤。
# 高合规场景可设为 true，使语义模型不可用时拒绝提交。
RAG_SEMANTIC_GUARD_FAIL_CLOSED=false

# Langfuse 可选观测。未同时开启并填写两项 Key 时严格为空操作。
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
# LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=v0.1.0
# 默认只上报阶段、耗时、模型和命中数，不上传问题、片段或答案正文。
LANGFUSE_CAPTURE_CONTENT=false

# 本地镜像默认验证 .so 已加载但不要求许可证；生产必须同时启用许可证校验。
NATIVE_CORE_REQUIRED=true
NATIVE_CORE_LICENSE_REQUIRED=false
# 生产构建时注入 Ed25519 公钥（64 位十六进制），该值只会编译进 .so。
# NATIVE_LICENSE_PUBLIC_KEY_HEX=
# KNOWLEDGE_CORE_LICENSE_FILE=/run/secrets/knowledge_core_license.json

PDF_MAX_PAGES=500
PDF_PARSE_MEMORY_LIMIT_MB=512
